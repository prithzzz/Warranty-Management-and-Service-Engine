# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git, so passwords never reach GitHub.

# MySQL (system of record)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=warranty_engine

# PostgreSQL + pgvector (semantic search)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=warranty_vectors

# Secret used to sign login tokens. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string
